# 노트북 4대 배치 — 각자 이 파일을 deploy/.env 로 복사해서 IP 를 채운다 (.env 는 커밋 금지)
# IP 는 시연 망에서 고정한 값 (팀원용_네트워크_규약.md). 모두 같은 값이어야 서로 찾는다.

BROKER_IP=        # A 노트북 — MQTT 브로커 · 수집서버
API_IP=           # B 노트북 — API 서버
DB_IP=            # C 노트북 — PostgreSQL
DASHBOARD_IP=     # D 노트북 — 대시보드
D_ROBOT_IP=       # D 로봇 — 대시보드가 UDP(9027)로 직접 명령

# C 노트북만 — DB 계정 (B 의 api-server/.env 의 DATABASE_URL 과 같은 값)
DB_USER=mechdog
DB_PASSWORD=
DB_NAME=mechdog
TEAM_SCHEMA_SQL=./mechdog_team_schema.sql   # 최현수 팀 스키마 파일 위치 (처음 한 번만 적용됨)

# A 노트북만 — 수집서버가 API 서버에 보낼 토큰 (김별이에게 받음)
COLLECTOR_TOKEN=
