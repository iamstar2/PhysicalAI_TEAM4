# 팀원 각자 서비스(vision-service, dialog-service, escort-service,
# security-dashboard)의 Dockerfile은 이 템플릿을 복사해서 자기 코드/의존성만 채우면 된다.
# 핵심은 "mechdog_common을 COPY + pip install 로 넣는다"는 패턴이 4명 모두 동일하다는 것.
#
# 전제: 이 Dockerfile은 아래와 같은 디렉터리 구조에서 빌드된다고 가정한다.
#   my-service/
#     Dockerfile          <- 이 파일을 복사
#     requirements.txt    <- 각자 서비스 전용 의존성 (예: opencv-python, onnxruntime 등)
#     app/                <- 각자 서비스 코드
#   mechdog_common/        <- 공용 패키지 (팀 공용 저장소에서 클론/서브트리로 가져옴)
#   pyproject.toml

FROM python:3.11-slim

WORKDIR /app

# 1) 공용 스키마 패키지를 먼저 설치 (자주 안 바뀌는 레이어를 앞에 둬서 캐시 활용)
COPY pyproject.toml /tmp/mechdog_common_build/pyproject.toml
COPY mechdog_common/ /tmp/mechdog_common_build/mechdog_common/
RUN pip install --no-cache-dir /tmp/mechdog_common_build

# 2) 이 서비스만의 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 3) 이 서비스 코드 복사
COPY app/ ./app/

# 컨테이너 이름 = MQTT 클라이언트 ID = 서비스명으로 통일 (compose에서 container_name으로 지정)
ENV MQTT_HOST=mosquitto
ENV MQTT_PORT=1883

CMD ["python", "-m", "app.main"]
