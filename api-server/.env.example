# api-server 설정 예시 — 복사해서 .env 로 쓴다 (.env 는 저장소에 올리지 않는다)

# DB (최현수) — IP · 계정은 받은 값으로
DATABASE_URL=postgresql://mechdog:<비밀번호>@<DB IP>:5432/mechdog

# 토큰 — "이름:토큰" 쉼표 구분. 이름은 app/security.py 의 PERMISSIONS 와 맞춘다
# 토큰 만들기: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKENS=collector:<토큰>,dashboard:<토큰>,mechdog_a:<토큰>,mechdog_b:<토큰>,mechdog_d:<토큰>

# 등록 사진 · 경고 사진 암호화 키 — 잃어버리면 저장된 사진을 못 연다
# 만들기: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHOTO_KEY=

# 경고 사진
SNAPSHOT_ROOT=/data/snap
SNAPSHOT_RETENTION_DAYS=7
ENCRYPT_SNAPSHOTS=1

# 적재 규칙 스위치
AUTO_CREATE_SESSION=1
EVENT_LOG_ALL=0

# 개발 중에만 — 토큰 검사 끄기
AUTH_DISABLED=0
